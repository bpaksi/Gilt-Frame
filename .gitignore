# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# App-specific ignores (node_modules, .next, env files, PII contacts, etc.)
# live in website/.gitignore, since website/ is the actual Next.js project root.

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# editors
*.swp

# root-level env files, if any (e.g. tooling shared across website/ and supabase/)
.env*
!.env.example

# Sensitive Twilio / account docs — do not push
docs/Twillio/
